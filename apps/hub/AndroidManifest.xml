<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.veloster.carplayhub" android:versionCode="24" android:versionName="1.23-wireless-preview">
    <uses-sdk android:minSdkVersion="17" android:targetSdkVersion="17" />
