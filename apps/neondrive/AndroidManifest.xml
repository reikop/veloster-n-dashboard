<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.veloster.neondrive" android:versionCode="27" android:versionName="0.27-preview">
    <uses-sdk android:minSdkVersion="17" android:targetSdkVersion="17" />
    <!-- Last known / passive GPS fixes only, for sunrise and sunset; never starts GPS itself. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application android:label="@string/app_name" android:allowBackup="false" android:hardwareAccelerated="true" android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen">
        <!-- OEM framework classes for the passive gear listeners; optional so the app still runs (demo) elsewhere. -->
        <uses-library android:name="automotive" android:required="false" />
        <activity android:name="com.veloster.neondrive.NeonDriveActivity" android:exported="true" android:screenOrientation="landscape" android:launchMode="singleTop">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
    </application>
</manifest>
