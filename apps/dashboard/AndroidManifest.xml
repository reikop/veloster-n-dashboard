<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.veloster.dashboard" android:versionCode="29" android:versionName="1.11.3">
    <uses-sdk android:minSdkVersion="17" android:targetSdkVersion="17" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- settings backup (SettingsBackup): a file on the head unit's storage that stays when the app is removed -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- floating window (FloatService) over other apps, and back after boot when switched on -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- taxi meter: the head unit GPS picks the fare area (TaxiZones); the position never leaves the app -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 설정 → 글꼴: the reboot a system font change needs (the same request as My Apps → 강제 재시작) -->
    <uses-permission android:name="android.permission.REBOOT" />
    <application android:name="com.veloster.diagnostics.DiagnosticApplication" android:label="@string/app_name" android:allowBackup="false" android:debuggable="true" android:theme="@android:style/Theme.Holo.NoActionBar">
        <uses-library android:name="automotive" android:required="true" />
        <activity android:name="com.veloster.dashboard.DashboardActivity" android:exported="true" android:screenOrientation="landscape" android:launchMode="singleTop">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name="com.veloster.dashboard.FloatService" android:exported="false" />
        <receiver android:name="com.veloster.dashboard.BootReceiver" android:exported="true">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /><action android:name="com.veloster.dashboard.FLOAT_START" /></intent-filter>
        </receiver>
    </application>
</manifest>
